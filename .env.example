# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/findersarmy"
# Public base URL of the app. Also used at BUILD time for canonical URLs and OG images.
APP_URL="http://localhost:3000"
# Auth.js: random secret (openssl rand -base64 32) and the same URL as APP_URL.
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
# Salt for one-way hashing of IP addresses and user agents (fraud checks). Never change once live.
HASH_SALT="replace-with-a-long-random-string"
# Protects /api/cron/daily (Vercel Cron sends it as a Bearer token).
CRON_SECRET="replace-with-a-long-random-string"

# ─── Payments (Mollie) ───────────────────────────────────────────────────────
# "mollie" in production; "fake" for local development without a Mollie account
# (a built-in test checkout that calls the real webhook). "fake" is refused in production.
PAYMENT_PROVIDER="fake"
# test_... key for Mollie test mode, live_... in production.
MOLLIE_API_KEY=""

# ─── E-mail (Resend) ─────────────────────────────────────────────────────────
# Without a key, mails go to the dev mailbox at /api/dev/mail (development only).
RESEND_API_KEY=""
EMAIL_FROM="FindersArmy <noreply@findersarmy.com>"
# Optional extra address that receives admin notifications.
ADMIN_EMAIL=""

# ─── Google login (optional) ─────────────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── File storage: Cloudflare R2 (optional; database storage is used without it) ─
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ─── Rate limiting: Upstash Redis (optional; in-memory without it) ───────────
# Required for multi-instance deployments such as Vercel.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Analytics (optional, cookieless) ────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ─── Feature flags ───────────────────────────────────────────────────────────
# Allow Finders aged 16-17 with parental consent.
ALLOW_16_PLUS="false"

# ─── Help assistant (optional) ───────────────────────────────────────────────
# With a key the bottom-right help chat answers with Claude; without it, it
# searches the site's own knowledge and links to the right page.
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-opus-5-5"

# ─── Test phase on a real host (Netlify) ─────────────────────────────────────
# DEMO_MODE=true: fake checkout instead of Mollie, mail to the in-site mailbox (/api/dev/mail)
# instead of Resend, and one-click demo logins on /login. Remove before real users arrive.
DEMO_MODE=""
# Optional: direct (non-pooled) Neon URL for migrations. Defaults to DATABASE_URL without "-pooler".
DIRECT_DATABASE_URL=""
